<?xml version="1.0" encoding="UTF-8"?>
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:oor="http://openoffice.org/2001/registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<dependency file="main"/>
<oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
 <node oor:name="Security"><node oor:name="Scripting">
  <prop oor:name="MacroSecurityLevel" oor:finalized="true"><value>3</value></prop>
  <prop oor:name="DisableMacrosExecution" oor:finalized="true"><value>true</value></prop>
  <prop oor:name="DisableActiveContent" oor:finalized="true"><value>true</value></prop>
  <prop oor:name="BlockUntrustedRefererLinks" oor:finalized="true"><value>true</value></prop>
 </node></node>
</oor:component-data>
<oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
 <node oor:name="Content"><node oor:name="Update"><prop oor:name="Link" oor:finalized="true"><value>2</value></prop></node></node>
</oor:component-data>
<oor:component-data oor:name="Calc" oor:package="org.openoffice.Office">
 <node oor:name="Content"><node oor:name="Update"><prop oor:name="Link" oor:finalized="true"><value>2</value></prop></node></node>
</oor:component-data>
</oor:data>
